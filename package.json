{
  "name": "dsh-slim-workbench",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Slim 工作台：侧边栏常驻的本地开发工作台。Node 管理 + 前端项目管理 + 后端项目管理，项目目录只读。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "nvm.js",
    "launcher.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "nvm",
    "launcher",
    "spring-boot",
    "workbench"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slim4221/dsh-slim-workbench.git"
  },
  "homepage": "https://github.com/slim4221/dsh-slim-workbench#readme",
  "bugs": {
    "url": "https://github.com/slim4221/dsh-slim-workbench/issues"
  }
}
